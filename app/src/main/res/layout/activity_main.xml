<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cajon"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Permisos pendientes (solo aparece si falta alguno) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPermisos"
                style="@style/Tarjeta"
                android:layout_margin="12dp"
                app:cardBackgroundColor="#FFF8E1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TituloTarjeta"
                        android:text="⚠ Permisos pendientes" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNotificaciones"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:text="Activar acceso a notificaciones (obligatorio)" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAccesibilidad"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:text="Activar accesibilidad (para enviar archivos)" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSuperponer"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:text="Permitir mostrar sobre otras apps (archivos)" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBateria"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:text="Quitar restricción de batería" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReglas"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="96dp" />

                <!-- Estado vacío -->
                <LinearLayout
                    android:id="@+id/vacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="170dp"
                        android:layout_height="170dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_logo_vacio" />

                    <TextView
                        android:id="@+id/tvVacio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="Toca + para crear una nueva regla de respuesta automática que uses para definir tus respuestas automáticas."
                        android:textColor="#B5B5B5"
                        android:textSize="19sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabNueva"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="Nueva regla"
            android:src="@drawable/ic_mas_blanco"
            app:backgroundTint="#76C80E"
            app:tint="@android:color/white" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/menuLateral"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/cabecera_cajon"
        app:itemIconTint="#555555"
        app:itemTextColor="@color/negro"
        app:menu="@menu/menu_cajon" />
</androidx.drawerlayout.widget.DrawerLayout>
