<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            style="@style/Ayuda"
            android:text="Guarda aquí fotos, PDFs, catálogos, audios o documentos. Cada archivo tiene una clave corta (ej. catalogo). Puedes elegirlo en una regla, o dejar que la IA lo envíe cuando un cliente lo pida. Mantén pulsado un archivo para borrarlo." />

        <ListView
            android:id="@+id/lvArchivos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="88dp" />

        <TextView
            android:id="@+id/tvVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="Aún no hay archivos. Toca + para agregar uno."
            android:textColor="@color/gris"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="Agregar archivo"
        android:src="@drawable/ic_agregar"
        app:backgroundTint="@color/amarillo"
        app:tint="@color/negro" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
