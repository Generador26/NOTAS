<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            style="@style/Ayuda"
            android:text="Simula un mensaje entrante para ver qué regla responde y qué contestaría (incluida la IA y las demás fuentes). No se envía nada por WhatsApp. La prueba recuerda la última regla, así puedes probar menús y submenús enviando varios mensajes seguidos." />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Campo"
            android:hint="Nombre del contacto">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContacto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:text="Cliente de prueba" />
        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/cbGrupo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Es un mensaje de grupo" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Campo"
            android:hint="Mensaje recibido">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:text="Hola" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Probar"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReiniciarPrueba"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Empezar conversación de prueba nueva" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Tarjeta"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="El resultado aparecerá aquí."
                android:textColor="@color/negro"
                android:textIsSelectable="true"
                android:textSize="15sp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
